<?xml version="1.0" encoding="utf-8"?>
<!--
    Primer plano del ícono: la letra A de Atenas, con el vértice resuelto
    como un punto de activación en ámbar.

    Todo el trazo queda dentro de la zona segura del ícono adaptativo
    (los 72dp centrales de los 108dp del lienzo), para que ningún
    lanzador lo recorte al aplicar su máscara.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pierna izquierda de la A -->
    <path
        android:pathData="M39,76 L53,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Pierna derecha de la A -->
    <path
        android:pathData="M55,38 L69,76"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Travesaño -->
    <path
        android:pathData="M45,63 L63,63"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Punto de activación sobre el vértice -->
    <path
        android:pathData="M54,32m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#FFFFB95C" />
</vector>
